{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yield.v1 response envelope",
  "type": "object",
  "required": ["run_id", "sequence", "request_id", "status", "result"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["completed", "failed"]
    },
    "result": {}
  },
  "additionalProperties": false
}
