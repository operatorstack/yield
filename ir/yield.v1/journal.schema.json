{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yield.v1 journal (replay input)",
  "type": "object",
  "required": ["run_id", "skill"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "$ref": "request-envelope.schema.json#/$defs/skillRef"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request", "response"],
        "properties": {
          "request": {
            "$ref": "request-envelope.schema.json#/$defs/request"
          },
          "response": {
            "$ref": "response-envelope.schema.json"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
