      },
      {
        "id": "inventory-release-mutation-sites", "frontier_action_id": "discharge-obligation:control.supervisory-rw:event-completeness",
        "method": "inspect", "target": ".github/workflows and scripts", "arguments": ["publish, release create, release edit, git tag, dist-tag, contents: write, id-token: write"], "required_capabilities": ["repository-read"], "allowed_environments": ["yield-local-checkout"],
        "evidence_value": "high", "cost": "medium", "irreversibility": "none", "retention": { "disposition": "release" }, "acceptance_criteria": ["every discovered release mutation site is mapped to a modeled event or explicitly excluded with a reason"]
