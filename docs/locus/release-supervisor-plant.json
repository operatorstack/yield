{
  "schema_version": 1,
  "id": "yield-release-supervisor-plant-v1",
  "subject": "Yield public npm stable-release plant after repository graduation. The model covers ordinary GitHub changes, dispatch, policy drift, npm delay, retry, seven-package npm publication, and GitHub release finalization. The private mirror runs independently and is outside this public-release completion claim. Administrator or npm-account compromise and permanent npm failure remain outside this bounded claim.",
  "evidence": [
    { "path": ".github/workflows/release.yml", "lines": "3-132", "note": "Read-only dispatch planning followed by protected, recomputed tag creation and a draft release." },
    { "path": ".github/workflows/npm-publish.yml", "lines": "3-177", "note": "Canary/stable separation, exact source and tag resolution, OIDC, runtime-first idempotent publication, and complete-unit verification." },
    { "path": ".github/workflows/release-finalize.yml", "lines": "3-99", "note": "Read-only tag preflight skips dry runs; finalization then requires the public npm receipt, seven npm versions, and an exact tag-to-SHA binding." },
    { "path": "scripts/check-release-control.mjs", "lines": "30-74", "note": "Static release-authority checks refuse projection sync, mutable actions, token credentials, direct private tag publishing, and premature finalization." },
    { "path": "scripts/audit-repository-controls.mjs", "lines": "17-29", "note": "Live repository audit requires read-only defaults, SHA pinning, strict protected main, admin enforcement, required checks, and immutable release tags." }
  ],
  "states": [
    { "id": "IDLE" },
    { "id": "INTENT_PENDING" },
    { "id": "SOURCE_UNTRUSTED" },
    { "id": "AUTHORIZED" },
    { "id": "TAGGED_DRAFT" },
    { "id": "PARTIAL" },
    { "id": "RETRY_WAIT" },
    { "id": "RELEASED", "marked": true },
    { "id": "REFUSED", "marked": true },
    { "id": "UNAUTHORIZED_PUBLISH" },
    { "id": "VERSION_SPLIT" },
    { "id": "FINALIZED_PARTIAL" }
  ],
  "events": [
    { "id": "dispatch", "controllable": false, "observable": true },
    { "id": "main_push_canary", "controllable": false, "observable": true },
    { "id": "direct_tag_attempt", "controllable": false, "observable": true },
    { "id": "authority_drift", "controllable": false, "observable": true },
    { "id": "registry_delay", "controllable": false, "observable": true },
    { "id": "registry_recovers", "controllable": false, "observable": true },
    { "id": "authorize_exact_source", "controllable": true, "observable": true },
    { "id": "refuse", "controllable": true, "observable": true },
    { "id": "create_tag_and_draft", "controllable": true, "observable": true },
    { "id": "publish_runtime", "controllable": true, "observable": true },
    { "id": "publish_main", "controllable": true, "observable": true },
    { "id": "retry_exact_version", "controllable": true, "observable": true },
    { "id": "verify_all_receipts_and_finalize", "controllable": true, "observable": true },
    { "id": "publish_without_authorization", "controllable": true, "observable": true },
    { "id": "publish_mismatched_version", "controllable": true, "observable": true },
    { "id": "finalize_without_receipts", "controllable": true, "observable": true }
  ],
  "transitions": [
    { "from": "IDLE", "event": "dispatch", "to": "INTENT_PENDING", "basis": "inferred", "evidence": [0] },
    { "from": "IDLE", "event": "main_push_canary", "to": "IDLE", "basis": "inferred", "evidence": [1] },
    { "from": "IDLE", "event": "direct_tag_attempt", "to": "IDLE", "basis": "inferred", "evidence": [2] },
    { "from": "INTENT_PENDING", "event": "authority_drift", "to": "SOURCE_UNTRUSTED", "basis": "assumed", "evidence": [3, 4] },
    { "from": "INTENT_PENDING", "event": "authorize_exact_source", "to": "AUTHORIZED", "basis": "inferred", "evidence": [0, 3, 4] },
    { "from": "INTENT_PENDING", "event": "refuse", "to": "REFUSED", "basis": "inferred", "evidence": [0] },
    { "from": "SOURCE_UNTRUSTED", "event": "refuse", "to": "REFUSED", "basis": "inferred", "evidence": [0, 4] },
    { "from": "AUTHORIZED", "event": "refuse", "to": "REFUSED", "basis": "inferred", "evidence": [0] },
    { "from": "AUTHORIZED", "event": "create_tag_and_draft", "to": "TAGGED_DRAFT", "basis": "inferred", "evidence": [0, 4] },
    { "from": "TAGGED_DRAFT", "event": "publish_runtime", "to": "PARTIAL", "basis": "inferred", "evidence": [1] },
    { "from": "TAGGED_DRAFT", "event": "registry_delay", "to": "RETRY_WAIT", "basis": "assumed", "evidence": [1] },
    { "from": "PARTIAL", "event": "publish_runtime", "to": "PARTIAL", "basis": "inferred", "evidence": [1] },
    { "from": "PARTIAL", "event": "publish_main", "to": "PARTIAL", "basis": "inferred", "evidence": [1] },
    { "from": "PARTIAL", "event": "retry_exact_version", "to": "PARTIAL", "basis": "inferred", "evidence": [1] },
    { "from": "PARTIAL", "event": "registry_delay", "to": "RETRY_WAIT", "basis": "assumed", "evidence": [1] },
    { "from": "RETRY_WAIT", "event": "registry_recovers", "to": "PARTIAL", "basis": "assumed", "evidence": [1] },
    { "from": "PARTIAL", "event": "verify_all_receipts_and_finalize", "to": "RELEASED", "basis": "inferred", "evidence": [2] },
    { "from": "INTENT_PENDING", "event": "publish_without_authorization", "to": "UNAUTHORIZED_PUBLISH", "basis": "assumed", "evidence": [0, 3] },
    { "from": "TAGGED_DRAFT", "event": "publish_mismatched_version", "to": "VERSION_SPLIT", "basis": "assumed", "evidence": [1] },
    { "from": "PARTIAL", "event": "publish_mismatched_version", "to": "VERSION_SPLIT", "basis": "assumed", "evidence": [1] },
    { "from": "PARTIAL", "event": "finalize_without_receipts", "to": "FINALIZED_PARTIAL", "basis": "assumed", "evidence": [2, 3] }
  ],
  "spec": {
    "description": "A stable release must not publish without authorization, split one version across the seven public npm packages, or become public before the npm publisher receipt matches the immutable source tag.",
    "forbidden_states": ["UNAUTHORIZED_PUBLISH", "VERSION_SPLIT", "FINALIZED_PARTIAL"],
    "forbidden_transitions": []
  },
  "targets": { "selector": "marked" },
  "execution_projection": {
    "schema_version": 1,
    "environments": [
      {
        "id": "yield-local-checkout",
        "kind": "local",
        "authority": "repository-owner",
        "capabilities": ["repository-read", "local-tests"],
