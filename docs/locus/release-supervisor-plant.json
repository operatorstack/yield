        "method": "inspect", "target": ".github/workflows/release-finalize.yml", "arguments": ["22-99"], "required_capabilities": ["repository-read"], "allowed_environments": ["yield-local-checkout"],
        "evidence_value": "high", "cost": "low", "irreversibility": "none", "retention": { "disposition": "release" }, "acceptance_criteria": ["finalization refuses unless the npm publisher run, all seven npm packages, and tag-to-SHA match"]
      },
      {
        "id": "inspect-main-package-gate", "frontier_action_id": "discharge-obligation:control.supervisory-rw:disable-mechanism:publish_main",
        "method": "inspect", "target": ".github/workflows/npm-publish.yml", "arguments": ["137-163"], "required_capabilities": ["repository-read"], "allowed_environments": ["yield-local-checkout"],
        "evidence_value": "medium", "cost": "low", "irreversibility": "none", "retention": { "disposition": "release" }, "acceptance_criteria": ["all runtime publication precedes main-package publication"]
      },
